{
  "name": "dyslexiasteps-extension",
  "version": "1.0.0",
  "private": true,
  "description": "Dyslexia Steps Reading Support — browser extension",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "lint:firefox": "web-ext lint --source-dir dist/firefox",
    "check": "npm run typecheck && npm run build && npm run lint:firefox"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.8",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "web-ext": "^10.8.0"
  },
  "dependencies": {
    "@fontsource/lexend": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@mozilla/readability": "^0.6.0",
    "hyphen": "^1.14.1"
  }
}
